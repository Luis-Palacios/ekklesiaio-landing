# Copy to .env.local and fill in. Never commit real values. See docs/DESIGN.md §10.
NEXT_PUBLIC_SITE_URL=https://ekklesiaio.com
DATABASE_URL=                      # Neon, pooled (Vercel Marketplace sets it)
DATABASE_URL_UNPOOLED=             # Neon, direct; build-time migrations only (not needed locally)
# Resend (confirmation emails). Without RESEND_API_KEY or EMAIL_FROM, dev logs the
# confirm link to the server console instead of sending; production fails the signup.
RESEND_API_KEY=
EMAIL_FROM=hello@ekklesiaio.com     # sender address only
EMAIL_FROM_NAME=ekklesiaio         # optional display name; sends as "ekklesiaio <hello@…>"
CONTACT_EMAIL=hello@ekklesiaio.com

# Turnstile (Invisible mode). Production uses real keys; Preview and local use
# Cloudflare's always-pass test keys:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000BB  (invisible)
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Without a secret, every signup fails verification.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis (rate limit), set by the Vercel Upstash integration. Not needed locally:
# if unset, dev skips the rate limit and production rejects signups.
KV_REST_API_URL=
KV_REST_API_TOKEN=
