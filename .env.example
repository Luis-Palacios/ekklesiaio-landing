# Copy to .env.local and fill in. Never commit real values. See docs/DESIGN.md §10.
NEXT_PUBLIC_SITE_URL=https://ekklesiaio.com
DATABASE_URL=                      # Neon (Vercel Marketplace sets it)
RESEND_API_KEY=
EMAIL_FROM="ekklesiaio <hello@ekklesiaio.com>"
CONTACT_EMAIL=hello@ekklesiaio.com

# Turnstile. For local dev, use Cloudflare's always-pass test keys:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Without a secret, every signup fails verification.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Upstash Redis (rate limit). The Vercel integration's KV_REST_API_URL / KV_REST_API_TOKEN
# also work. If unset, dev skips the rate limit and production rejects signups.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
